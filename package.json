    "prettier": "^3.5.0",
    "prisma": "^6.3.1"
  },
  "peerDependencies": {
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "@trpc/server": "^10.45.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "trpc-panel": "^1.3.4",
    "zod": "^3.24.1"
